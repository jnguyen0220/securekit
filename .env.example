# ---------------------------------------------------------------------------
# securekit configuration example
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# On startup the scanner loads simple KEY=VALUE pairs from `.env` in the current
# directory. Existing environment variables take precedence over `.env` values.
# Never commit your real `.env` — it contains credentials.
# ---------------------------------------------------------------------------

# ===========================================================================
# GitHub authentication
# ===========================================================================
# The scanner needs GitHub API access to search for and enumerate public
# repositories. Anonymous access is capped at 60 requests/hour, so provide
# credentials for any real workload.

# --- Option A: Personal access token (simplest) ----------------------------
# A classic or fine-grained PAT. Either GITHUB_TOKEN or GH_TOKEN is accepted.
GITHUB_TOKEN=ghp_your_personal_access_token_here
# GH_TOKEN=ghp_your_personal_access_token_here

# --- Option B: GitHub App (higher rate limits, recommended at scale) --------
# A GitHub App authenticates as an installation and gets much higher rate
# limits than a PAT, and its token rotates automatically. When all three of
# GITHUB_APP_ID, GITHUB_APP_INSTALLATION_ID, and a private key are set, the
# scanner mints an installation token and uses it for API calls AND for
# authenticated `git clone`. The token is auto-refreshed as it nears its ~1
# hour expiry (and on a 401), so long-running crawls/bots keep working. On any
# failure it falls back to GITHUB_TOKEN, then anonymous.
GITHUB_APP_ID=123456
GITHUB_APP_INSTALLATION_ID=98765432

# Point to the App's private key (.pem) on disk...
GITHUB_APP_PRIVATE_KEY_PATH=./securekit-app.private-key.pem
# ...or inline the PEM contents (use \n for newlines when set via env):
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ===========================================================================
# Server mode (coordination server that hands out work)
# ===========================================================================
SECUREKIT_BIND=127.0.0.1:8080
SECUREKIT_LEASE_SECS=300
# SECUREKIT_WORKER_TTL_SECS=60   # heartbeat window before a worker is dropped
# SECUREKIT_SCAN_WORKERS=4       # repos each bot scans in parallel (sent on /register)
# SECUREKIT_CLAIM_BATCH=10       # repos leased per /claim (sent on /register)

# Ignore rules the server ships to every bot (optional):
# SECUREKIT_IGNORE_FILE=./ignore.txt   # extra ignore regexes, one per line
# SECUREKIT_NO_DEFAULT_IGNORES=0       # set to 1 to drop the built-in defaults

# ===========================================================================
# Target list (repositories to scan) and results output
# ===========================================================================
# The server enumerates public repositories natively. To scan a fixed list
# instead, point SECUREKIT_LIST_FILE at a file of repo URLs (one per line);
# this DISABLES live enumeration.
# SECUREKIT_LIST_FILE=repos.txt

# Where native enumeration starts (numeric repo id cursor; 0 = the beginning):
SECUREKIT_ENUM_SINCE=0

# --- Redacted results output (JSON Lines) -----------------------------------
SECUREKIT_RESULTS_FILE=results.jsonl

# The scan cache (commit SHAs, to skip unchanged repos) always lives at
# ./.scan-cache.json.
